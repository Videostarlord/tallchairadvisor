---
import '../styles/global.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/500.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  schema?: object | object[];
  noindex?: boolean;
  preloadImage?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/og-default.webp',
  ogType = 'website',
  schema,
  noindex = false,
  preloadImage,
} = Astro.props;

const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const gaEnabled = Boolean(gaMeasurementId);
const canonicalURL = canonical ?? new URL(Astro.url.pathname, 'https://tallchairadvisor.com').href;
const socialImageURL = new URL(ogImage, 'https://tallchairadvisor.com').href;

const schemaArray = Array.isArray(schema) ? schema : (schema ? [schema] : []);
const breadcrumbSchema = schemaArray.find((s: any) => s['@type'] === 'BreadcrumbList');
const breadcrumbs: { name: string; href: string }[] = breadcrumbSchema?.itemListElement?.map((item: any) => ({
  name: item.name,
  href: item.item,
})) ?? [];
---

<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tall Chair Advisor" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Tall Chair Advisor" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Performance hints -->
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {gaEnabled && <link rel="preconnect" href="https://www.googletagmanager.com" />}

    <!-- GA4 -->
    {gaEnabled && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag(){window.dataLayer.push(arguments);}
          window.gtag('js', new Date());
          window.gtag('config', gaMeasurementId);
        </script>
        <script is:inline>
          const AFFILIATE_TAG = 'tallchairadvi-20';

          // Direct affiliate programs (non-Amazon). Domain suffix → program name.
          const DIRECT_PROGRAMS = {
            'autonomous.ai': 'autonomous',
            'humanscale.com': 'humanscale',
            'inmovement.com': 'inmovement',
            'flexispot.com': 'flexispot',
            'branchfurniture.com': 'branch',
            'crandalloffice.com': 'crandall',
          };

          const normalizeDomain = (hostname) => hostname.replace(/^www\./, '');

          const getAnchor = (target) => target instanceof Element ? target.closest('a') : null;

          const matchDirectProgram = (url) => {
            const domain = normalizeDomain(url.hostname);
            for (const [suffix, program] of Object.entries(DIRECT_PROGRAMS)) {
              if (domain === suffix || domain.endsWith('.' + suffix)) return program;
            }
            return null;
          };

          const isTrackedAffiliateLink = (link) => {
            if (!(link instanceof HTMLAnchorElement)) return false;
            if (link.dataset.affiliateCta === 'true') return true;

            try {
              const url = new URL(link.href, window.location.origin);
              if (matchDirectProgram(url)) return true;
              return normalizeDomain(url.hostname).endsWith('amazon.com')
                && url.searchParams.get('tag') === AFFILIATE_TAG;
            } catch {
              return false;
            }
          };

          const getAffiliateProgram = (link, url) => {
            if (link.dataset.affiliateProgram) return link.dataset.affiliateProgram;
            const direct = matchDirectProgram(url);
            if (direct) return direct;
            return normalizeDomain(url.hostname).endsWith('amazon.com') ? 'amazon' : 'unknown';
          };

          const getCtaLabel = (link) => {
            const explicitLabel = link.dataset.ctaLabel || link.getAttribute('aria-label') || link.getAttribute('title');
            if (explicitLabel) return explicitLabel.trim();

            const visibleText = link.textContent?.replace(/\s+/g, ' ').trim();
            return visibleText || 'affiliate link';
          };

          const getCtaPosition = (link) => {
            if (link.dataset.ctaPosition) return link.dataset.ctaPosition;
            if (link.closest('table')) return 'table';
            if (link.closest('footer')) return 'footer';
            if (link.closest('nav')) return 'nav';
            if (link.closest('header')) return 'hero';

            const documentHeight = Math.max(
              document.documentElement.scrollHeight,
              document.body.scrollHeight,
              window.innerHeight
            );
            const absoluteTop = link.getBoundingClientRect().top + window.scrollY;
            const ratio = documentHeight > 0 ? absoluteTop / documentHeight : 0;

            if (ratio < 0.25) return 'hero';
            if (ratio < 0.6) return 'mid';
            return 'lower';
          };

          let lastTrackedKey = '';
          let lastTrackedAt = 0;

          const trackAffiliateClick = (event) => {
            const link = getAnchor(event.target);
            if (!link || !isTrackedAffiliateLink(link) || typeof window.gtag !== 'function') return;

            let url;
            try {
              url = new URL(link.href, window.location.origin);
            } catch {
              return;
            }

            const ctaPosition = getCtaPosition(link);
            const dedupeKey = `${event.type}:${url.href}:${ctaPosition}`;
            const now = Date.now();
            if (dedupeKey === lastTrackedKey && now - lastTrackedAt < 750) return;

            lastTrackedKey = dedupeKey;
            lastTrackedAt = now;

            window.gtag('event', 'affiliate_click', {
              page_path: window.location.pathname,
              page_title: document.title,
              destination_domain: normalizeDomain(url.hostname),
              affiliate_program: getAffiliateProgram(link, url),
              cta_label: getCtaLabel(link),
              cta_position: ctaPosition,
              link_url: url.href,
              transport_type: 'beacon'
            });
          };

          document.addEventListener('click', trackAffiliateClick, true);
          document.addEventListener('auxclick', trackAffiliateClick, true);
        </script>
      </>
    )}

    <!-- Schema -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Robots -->
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    }

    <!-- Microsoft Clarity -->
    <script type="text/javascript" is:inline>(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window, document, "clarity", "script", "wqec7ap5fe");</script>

    <!-- Impact Universal Tracking Tag (affiliate — impact.com) -->
    <script type="text/javascript" is:inline>(function(i,m,p,a,c,t){c.ire_o=p;c[p]=c[p]||function(){(c[p].a=c[p].a||[]).push(arguments)};t=a.createElement(m);var z=a.getElementsByTagName(m)[0];t.async=1;t.src=i;z.parentNode.insertBefore(t,z)})('https://utt.impactcdn.com/P-A7520162-06d8-497a-9901-740bba6ba6d71.js','script','impactStat',document,window);impactStat('transformLinks');impactStat('trackImpression');</script>
  </head>
  <body>
    <Header />
    {breadcrumbs.length > 1 && (
      <nav aria-label="Breadcrumb" class="border-b border-border bg-background">
        <div class="container-wide">
          <ol class="flex flex-wrap items-center gap-1 py-2 text-sm text-muted-foreground">
            {breadcrumbs.map((crumb, i) => (
              <li class="flex items-center gap-1">
                {i < breadcrumbs.length - 1 ? (
                  <>
                    <a href={crumb.href} class="hover:text-foreground transition-colors">{crumb.name}</a>
                    <span aria-hidden="true" class="text-border">/</span>
                  </>
                ) : (
                  <span aria-current="page" class="text-foreground font-medium">{crumb.name}</span>
                )}
              </li>
            ))}
          </ol>
        </div>
      </nav>
    )}
    <slot />
    <Footer />
  </body>
</html>
