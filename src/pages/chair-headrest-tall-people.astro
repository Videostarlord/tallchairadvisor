                <td class="p-3 text-center">~11"</td>
              </tr>
              <tr class="hover:bg-secondary/20">
                <td class="p-3 font-medium">Herman Miller Aeron Size C</td>
                <td class="p-3 text-center">16"–20.5"</td>
