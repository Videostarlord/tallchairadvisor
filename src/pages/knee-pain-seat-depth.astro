---
import Layout from '../layouts/Layout.astro';
import Byline from '../components/Byline.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Knee Pain from Office Chair Seat Depth: Tall People Guide",
    "url": "https://tallchairadvisor.com/knee-pain-seat-depth/",
    "description": "How seat depth causes knee pain in tall people, what the correct seat depth is for your leg length, and which chairs offer enough adjustment.",
    "image": "https://tallchairadvisor.com/images/og-default.webp",
    "datePublished": "2024-12-02",
    "wordCount": 1082,
    "dateModified": "2026-05-07",
    "author": { "@type": "Person", "@id": "https://tallchairadvisor.com/author/jackson-christopher/#person", "name": "Jackson Christopher", "description": "Mechanical Engineering student at UC Berkeley, 6'4\", daily Steelcase Gesture user", "url": "https://tallchairadvisor.com/author/jackson-christopher/" },
    "publisher": {
      "@type": "Organization",
      "name": "Tall Chair Advisor",
      "logo": { "@type": "ImageObject", "url": "https://tallchairadvisor.com/images/og-default.webp" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://tallchairadvisor.com/" },
      { "@type": "ListItem", "position": 2, "name": "Pain & Ergonomics", "item": "https://tallchairadvisor.com/pain-ergonomics/" },
      { "@type": "ListItem", "position": 3, "name": "Knee Pain & Seat Depth", "item": "https://tallchairadvisor.com/knee-pain-seat-depth/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What seat depth do tall people need to avoid knee pain?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Users 6'0\"–6'2\" typically need a minimum seat depth of 18–19 inches. Users 6'2\"–6'4\" generally need 19–20 inches. Users 6'5\" and above often need 20–21 inches or more. Standard office chairs offer 15–17 inches of seat depth — commonly 2–5 inches less than what tall users require. The correct target is your thigh length (hip to back of knee) minus 2–3 inches, which maintains the necessary clearance at the knee crease."
        }
      },
      {
        "@type": "Question",
        "name": "Why does a shallow seat cause knee pain?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "When a seat is too shallow for a user's thigh length, the front edge of the seat cushion presses directly into the popliteal region — the soft tissue behind the knee where the popliteal artery, tibial nerve, and major tendons pass close to the surface. Sustained pressure here restricts blood flow to the lower leg, compresses the tibial nerve, and creates the characteristic pain, tingling, and numbness that builds throughout the workday. The longer the session, the more pronounced the discomfort becomes as circulation restriction compounds."
        }
      },
      {
        "@type": "Question",
        "name": "How do I measure the correct seat depth for my body?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sit with your back fully against a flat wall or backboard on a firm, flat surface with your feet flat on the floor. Measure from the wall to a point 2–3 inches in front of your knee crease. This measurement is your minimum required seat depth. If your chair's seat depth (or its maximum depth with the slider extended) is less than this number, the seat will press into your knees when you sit fully back against the lumbar support."
        }
      },
      {
        "@type": "Question",
        "name": "Can sliding forward in the seat solve the knee pain from seat depth?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sliding forward relieves the pressure on the back of the knees, but it creates a second, more serious problem: it disconnects your back from the lumbar support. Once you're no longer in contact with the lumbar support, the spine loses its structural backing and must be held upright by muscular effort alone. Over time this causes back and neck pain. Sliding forward is a temporary relief strategy that trades knee pain for spinal strain — it does not solve the underlying dimensional mismatch."
        }
      },
      {
        "@type": "Question",
        "name": "Which chairs have enough seat depth for tall users?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Herman Miller Aeron Size C offers an adjustable seat depth range of approximately 18.5–20.5 inches, making it one of the better options for tall users with longer thighs. The Steelcase Leap Plus provides a seat depth range of 17–20.5 inches with a seat slider. The Steelcase Gesture maxes out around 17.75 inches of seat depth, which may be insufficient for users needing 19+ inches. Always verify the maximum depth of the slider range against your measured requirement before purchasing."
        }
      }
    ]
  }
];
---

<Layout
  title="Cornell Ergonomics Rule: Seat Depth & Knee Pain for Tall People"
  description="Seat edge pressure on the back of your knees is the cause. Here's how to measure the right seat depth for your height and which chairs reach it."
  ogType="article"
  schema={schema}
>
  <header class="py-12 md:py-16 lg:py-20 bg-secondary/30">
    <div class="container-article text-center">
      <h1 class="text-balance">The Cornell Ergonomics Rule for Seat Depth (What Tall People Get Wrong)</h1>
      <p class="mt-4 text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto animate-slide-up">
        How insufficient seat depth creates pressure and circulation problems for tall users
      </p>
    </div>
  </header>

  <article class="container-article py-12 md:py-16">
    <Byline publishedDate="2024-12-02" updatedDate="2026-03-08" />
    <div class="bg-blue-50 border border-blue-200 rounded-lg px-4 py-3 mb-8 text-sm text-blue-900">
      <strong>Note:</strong> This content is for informational purposes only and does not constitute medical advice. If you experience persistent back, knee, or leg pain, consult a qualified healthcare professional.
    </div>

    <div class="bg-card border border-border rounded-lg p-5 my-8">
      <p class="font-semibold mb-2">The Cornell Ergonomics Rule</p>
      <p>Cornell ergonomics research defines correct seat depth as leaving 2–3 finger-widths of clearance between the front edge of the seat and the back of your knees. For most tall people, this means choosing a chair with a seat depth of 18–20 inches minimum. Standard office chairs top out at 17 inches — which is why knee pain is a tall-person problem, not a sitting posture problem.</p>
    </div>

    <!-- Seat Depth Calculator -->
    <div id="seat-depth-calc" class="my-10 bg-card border border-border rounded-xl overflow-hidden">
      <div class="bg-primary/5 border-b border-border px-6 py-4">
        <p class="font-semibold text-heading text-lg">Seat Depth Calculator</p>
        <p class="text-sm text-muted-foreground mt-1">Select your height and body type to find your minimum seat depth and which chairs cover it.</p>
      </div>

      <div class="p-6">
        <!-- Step 1: Height -->
        <div id="calc-step1">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-3">Step 1 — How tall are you?</p>
          <div class="flex flex-wrap gap-2">
            <button class="height-btn px-4 py-2 rounded-md border border-border text-sm font-medium hover:border-primary hover:text-primary transition-colors" data-height="6.0">6'0"–6'1"</button>
            <button class="height-btn px-4 py-2 rounded-md border border-border text-sm font-medium hover:border-primary hover:text-primary transition-colors" data-height="6.1">6'1"–6'2"</button>
            <button class="height-btn px-4 py-2 rounded-md border border-border text-sm font-medium hover:border-primary hover:text-primary transition-colors" data-height="6.2">6'2"–6'3"</button>
            <button class="height-btn px-4 py-2 rounded-md border border-border text-sm font-medium hover:border-primary hover:text-primary transition-colors" data-height="6.3">6'3"–6'4"</button>
            <button class="height-btn px-4 py-2 rounded-md border border-border text-sm font-medium hover:border-primary hover:text-primary transition-colors" data-height="6.4">6'4"–6'5"</button>
            <button class="height-btn px-4 py-2 rounded-md border border-border text-sm font-medium hover:border-primary hover:text-primary transition-colors" data-height="6.5">6'5"+</button>
          </div>
        </div>

        <!-- Step 2: Body type (revealed after height selection) -->
        <div id="calc-step2" class="hidden mt-8">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-4">Step 2 — Which best describes your proportions?</p>
          <div class="grid grid-cols-3 gap-3 max-w-lg">

            <!-- Short legs / long torso -->
            <button class="body-btn flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-border hover:border-primary transition-colors cursor-pointer" data-body="short">
              <svg viewBox="0 0 60 120" width="56" height="112" aria-hidden="true">
                <circle cx="30" cy="10" r="9" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
                <rect x="27" y="19" width="6" height="5" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1"/>
                <rect x="14" y="24" width="32" height="56" rx="3" fill="#dbeafe" stroke="#60a5fa" stroke-width="1.5"/>
                <rect x="14" y="81" width="14" height="32" rx="3" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
                <rect x="32" y="81" width="14" height="32" rx="3" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
              </svg>
              <p class="text-xs font-medium text-heading text-center leading-snug">Short legs<br/>long torso</p>
            </button>

            <!-- Average proportions -->
            <button class="body-btn flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-border hover:border-primary transition-colors cursor-pointer" data-body="average">
              <svg viewBox="0 0 60 120" width="56" height="112" aria-hidden="true">
                <circle cx="30" cy="10" r="9" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
                <rect x="27" y="19" width="6" height="5" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1"/>
                <rect x="14" y="24" width="32" height="40" rx="3" fill="#dbeafe" stroke="#60a5fa" stroke-width="1.5"/>
                <rect x="14" y="65" width="14" height="48" rx="3" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
                <rect x="32" y="65" width="14" height="48" rx="3" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
              </svg>
              <p class="text-xs font-medium text-heading text-center leading-snug">Average<br/>proportions</p>
            </button>

            <!-- Long legs / short torso -->
            <button class="body-btn flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-border hover:border-primary transition-colors cursor-pointer" data-body="long">
              <svg viewBox="0 0 60 120" width="56" height="112" aria-hidden="true">
                <circle cx="30" cy="10" r="9" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
                <rect x="27" y="19" width="6" height="5" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1"/>
                <rect x="14" y="24" width="32" height="24" rx="3" fill="#dbeafe" stroke="#60a5fa" stroke-width="1.5"/>
                <rect x="14" y="49" width="14" height="64" rx="3" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
                <rect x="32" y="49" width="14" height="64" rx="3" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.5"/>
              </svg>
              <p class="text-xs font-medium text-heading text-center leading-snug">Long legs<br/>short torso</p>
            </button>

          </div>

          <!-- Manual toggle -->
          <div class="mt-5">
            <button id="manual-toggle" class="text-xs text-muted-foreground hover:text-primary underline transition-colors">
              I know my exact inseam — enter it instead →
            </button>
          </div>

          <!-- Manual inseam input (hidden by default) -->
          <div id="calc-manual" class="hidden mt-4">
            <div class="flex flex-wrap items-center gap-3">
              <label for="inseam-input" class="text-sm font-medium text-heading">My inseam:</label>
              <input
                id="inseam-input"
                type="number"
                min="26"
                max="42"
                placeholder="e.g. 34"
                class="w-24 px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
              />
              <span class="text-sm text-muted-foreground">inches</span>
              <button id="manual-calc-btn" class="px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:bg-primary/90 transition-colors">
                Calculate
              </button>
            </div>
            <p class="text-xs text-muted-foreground mt-2">Standing inseam measured from floor to crotch, shoes off.</p>
          </div>
        </div>

        <!-- Results (hidden until complete) -->
        <div id="calc-results" class="hidden mt-6 pt-6 border-t border-border">
          <div class="flex flex-wrap items-baseline gap-2 mb-1">
            <p class="text-sm text-muted-foreground">Your minimum seat depth:</p>
            <p class="text-3xl font-bold text-primary" id="result-depth">—</p>
            <p class="text-sm text-muted-foreground">inches</p>
          </div>
          <p class="text-xs text-muted-foreground mb-5" id="result-note"></p>

          <p class="text-sm font-semibold text-heading mb-3">Chairs that cover your requirement:</p>
          <div id="result-chairs" class="space-y-2"></div>
        </div>
      </div>
    </div>

    <div class="prose-tca">
      <section>
        <h2>The Popliteal Pressure Problem</h2>
        <!-- tca-aio-capsule -->
        <p>The Cornell Ergonomics Rule: leave 2–3 finger-widths of clearance between the seat front edge and the back of your knees. Tall users 6'0"–6'2" typically need 18–19 inches of seat depth; 6'2"–6'4" users need 19–20 inches. Standard office chairs top out at 17 inches, creating the popliteal pressure that causes knee and leg pain for tall people.</p>
        <p>
          The popliteal region — the soft area behind your knee — contains blood vessels,
          nerves, and tendons. When a seat is too shallow for your thigh length, the
          edge of the seat pan presses directly into this sensitive area.
        </p>
        <p>
          This compression restricts blood flow to your lower legs and puts pressure on
          the tibial nerve, leading to numbness, tingling, and chronic discomfort that
          builds throughout the workday. Research documented through
          <a href="https://pubmed.ncbi.nlm.nih.gov/" class="underline text-muted-foreground hover:text-primary" target="_blank" rel="noopener noreferrer">PubMed studies on seated pressure distribution</a>
          consistently identifies popliteal compression as a primary driver of lower-limb
          discomfort in users whose thigh length exceeds chair seat depth — a mismatch
          that disproportionately affects tall users.
        </p>
      </section>

      <section>
        <h2>How Seat Depth Relates to Thigh Length</h2>
        <p>
          Proper seat depth should allow two to three finger-widths (approximately 2–3 inches)
          of clearance between the seat edge and the back of your knees when sitting with
          your back against the backrest.
        </p>
        <p>
          As noted in
          <a href="https://ergo.human.cornell.edu/" class="underline text-muted-foreground hover:text-primary" target="_blank" rel="noopener noreferrer">Cornell University Ergonomics Lab guidance on seated workstation setup</a>,
          the seat pan should support the thigh along its full length without creating
          pressure at the distal edge. For tall users with longer femurs, this typically requires:
        </p>
        <ul>
          <li>Minimum seat depth of 18–19 inches for users 6'0" to 6'2"</li>
          <li>19–20 inches of depth for users 6'2"–6'4"</li>
          <li>20+ inches of depth for users 6'5" and taller</li>
          <li>Adjustable seat depth (seat slider) to fine-tune the fit</li>
        </ul>
        <p>
          Standard office chairs offer 15–17 inches — commonly 2–5 inches less than tall users
          need. This gap is the single most common cause of knee pain and lower-limb discomfort
          in tall office workers.
        </p>
      </section>

      <section>
        <h2>The Compensatory Posture Cascade</h2>
        <p>
          When the seat is too shallow, users naturally compensate by sliding forward
          to relieve knee pressure. This creates a cascade of problems:
        </p>
        <ul>
          <li>Loss of lumbar support as the back moves away from the backrest</li>
          <li>Increased spinal compression from unsupported sitting</li>
          <li>Neck strain as the head moves forward to maintain visual alignment</li>
        </ul>
        <p>
          What begins as knee discomfort often manifests as
          <a href="/back-pain-spine-height/" class="link-internal">back pain</a> and neck pain
          due to these compensatory positions. The knee pressure is the trigger, but the
          downstream spinal consequences are often what bring the problem to a head.
        </p>
      </section>

      <section>
        <h2>Measuring Your Requirements</h2>
        <p>To determine your ideal seat depth:</p>
        <ol>
          <li>Sit with your back fully against a wall on a firm, flat surface</li>
          <li>Measure from the wall to a point 2–3 inches in front of your knee crease</li>
          <li>This measurement is your minimum seat depth requirement</li>
        </ol>
        <p>
          Most tall users find they need depths that exceed standard chair offerings,
          pointing toward chairs with adjustable seat pans or models specifically
          designed for larger users. See our
          <a href="/correct-chair-dimensions/" class="link-internal">correct chair dimensions guide</a>
          for the full dimensional reference table and comparison to common chair models.
        </p>
      </section>

      <section>
        <h2>Adjustable Seat Depth vs Fixed Seat Depth</h2>
        <p>
          Not all chairs handle seat depth the same way. There are two categories:
        </p>

        <h3>Fixed Seat Depth</h3>
        <p>
          The seat pan has one depth, period. If it doesn't match your thigh length, you can't fix it. The Herman Miller
          Aeron Size C falls into this category with its fixed 18.5" depth. For users
          at 6'0"–6'2" this is often workable; for users 6'3"+ it starts to fall short.
        </p>

        <h3>Adjustable Seat Depth (Seat Slider)</h3>
        <p>
          A mechanism that lets you extend the seat pan forward independently of the backrest, typically
          2–4 inches of range. This is the right solution for tall users because it
          lets you dial in the 2–3 inch clearance at the knee regardless of your exact
          thigh length. The Steelcase Leap Plus and Steelcase Gesture both use this
          approach.
        </p>
        <p>
          If you're 6'2" or taller, prioritize chairs with an adjustable seat depth slider.
          A fixed-depth chair is a gamble on whether the manufacturer's single measurement
          happens to match your body — an adjustable one lets you set it correctly.
        </p>
      </section>

      <section>
        <h2>Chairs With Adequate Seat Depth for Tall Users</h2>
        <p>
          Based on the measurement requirements above, here's how the top tall-user chairs
          compare on seat depth:
        </p>

        <h3>Steelcase Leap Plus</h3>
        <p>
          <a href="/review/leap-plus/" class="link-internal">Steelcase Leap Plus</a>
          — 15.75" to 19.75" adjustable (4" range). Best seat depth flexibility available
          in a mainstream ergonomic chair. Covers users up to approximately 6'6".
        </p>

        <h3>Steelcase Gesture</h3>
        <p>
          <a href="/review/gesture/" class="link-internal">Steelcase Gesture</a>
          — 15.75" to 18.75" adjustable (3" range). Sufficient for most users up to 6'4".
          Above that, the Leap Plus's extra inch of maximum depth becomes relevant.
        </p>

        <h3>Herman Miller Aeron Size C</h3>
        <p>
          <a href="/review/aeron-size-c/" class="link-internal">Herman Miller Aeron Size C</a>
          — fixed 18.5". Works for 6'0"–6'2" with average thigh proportions. Users with
          longer-than-average femurs relative to their height may find it marginal even
          at 6'1".
        </p>
        <p>
          The practical takeaway: measure your thigh length first, then filter chairs by
          whether their maximum seat depth meets your number. Don't let overall reviews or
          brand reputation substitute for this single measurement check — it's the most
          reliable predictor of whether a chair will cause knee pain for your specific body.
        </p>
      </section>

      <div class="not-prose bg-card border border-border rounded-lg p-5 my-8">
        <p class="text-sm font-semibold text-heading mb-2">Chairs with enough seat depth for tall users</p>
        <p class="text-sm text-muted-foreground mb-4">The Steelcase Leap Plus reaches 19.75" of adjustable seat depth — the widest range of any mainstream ergonomic chair. The Steelcase Gesture adjusts to 18.75". The Herman Miller Aeron Size C has a fixed 18.5" depth. Match against your measured thigh length before buying.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="https://www.amazon.com/s?k=Steelcase+Leap+Plus&tag=tallchairadvi-20" target="_blank" rel="noopener noreferrer sponsored" class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-5 py-3 rounded-md font-medium hover:bg-primary/90 transition-colors text-sm">
            View Steelcase Leap Plus on Amazon →
          </a>
          <a href="https://www.amazon.com/s?k=steelcase+gesture+chair&tag=tallchairadvi-20" target="_blank" rel="noopener noreferrer sponsored" class="inline-flex items-center gap-2 border border-border text-heading px-5 py-3 rounded-md font-medium hover:bg-accent transition-colors text-sm">
            View Steelcase Gesture on Amazon →
          </a>
        </div>
      </div>

      <section>
        <h2>Related Reading</h2>
        <ul>
          <li><a href="/back-pain-spine-height/" class="link-internal">Back Pain from Office Chairs for Tall People</a></li>
          <li><a href="/leg-pain-circulation/" class="link-internal">Leg Pain &amp; Poor Circulation from Office Chairs (Tall People)</a></li>
          <li><a href="/correct-chair-dimensions/" class="link-internal">Correct Chair Dimensions for Tall Users</a></li>
          <li><a href="/chairs/steelcase-leap-plus/tall-people/" class="link-internal">Steelcase Leap Plus: adjustable seat depth fit guide</a></li>
        </ul>
        <div class="mt-6 pt-6 border-t border-border">
          <a href="/pain-ergonomics/" class="link-internal">← Back to Pain &amp; Ergonomics</a>
        </div>
      </section>
    </div>
  </article>
</Layout>

<script>
(function () {
  const baseDepths: Record<string, number> = {
    '6.0': 17.5,
    '6.1': 18.0,
    '6.2': 18.5,
    '6.3': 19.0,
    '6.4': 19.5,
    '6.5': 20.5,
  };

  const modifiers: Record<string, number> = {
    short: -1.5,
    average: 0,
    long: 1.5,
  };

  const chairs = [
    {
      name: 'Steelcase Leap Plus',
      maxDepth: 19.75,
      note: 'adjustable 15.75"–19.75"',
      url: '/review/leap-plus/',
      amazon: 'https://www.amazon.com/s?k=Steelcase+Leap+Plus&tag=tallchairadvi-20',
    },
    {
      name: 'Steelcase Gesture',
      maxDepth: 18.75,
      note: 'adjustable 15.75"–18.75"',
      url: '/review/gesture/',
      amazon: 'https://www.amazon.com/s?k=steelcase+gesture+chair&tag=tallchairadvi-20',
    },
    {
      name: 'Herman Miller Aeron Size C',
      maxDepth: 18.5,
      note: 'fixed 18.5"',
      url: '/review/aeron-size-c/',
      amazon: 'https://www.amazon.com/s?k=herman+miller+aeron+size+c&tag=tallchairadvi-20',
    },
  ];

  let selectedHeight: string | null = null;
  let selectedBody: string | null = null;

  const step2 = document.getElementById('calc-step2')!;
  const resultsEl = document.getElementById('calc-results')!;
  const manualSection = document.getElementById('calc-manual')!;
  const manualToggle = document.getElementById('manual-toggle')!;

  document.querySelectorAll<HTMLButtonElement>('.height-btn').forEach((btn) => {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.height-btn').forEach((b) =>
        b.classList.remove('border-primary', 'text-primary', 'bg-primary/5')
      );
      this.classList.add('border-primary', 'text-primary', 'bg-primary/5');
      selectedHeight = this.dataset.height!;
      step2.classList.remove('hidden');
      resultsEl.classList.add('hidden');
      selectedBody = null;
      document.querySelectorAll('.body-btn').forEach((b) =>
        b.classList.remove('border-primary', 'bg-primary/5')
      );
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.body-btn').forEach((btn) => {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.body-btn').forEach((b) =>
        b.classList.remove('border-primary', 'bg-primary/5')
      );
      this.classList.add('border-primary', 'bg-primary/5');
      selectedBody = this.dataset.body!;
      if (selectedHeight) {
        const base = baseDepths[selectedHeight] ?? 18.5;
        const mod = modifiers[selectedBody] ?? 0;
        const minDepth = Math.round((base + mod) * 2) / 2;
        const bodyLabel =
          { short: 'short legs / long torso', average: 'average proportions', long: 'long legs / short torso' }[
            selectedBody
          ] ?? '';
        showResults(minDepth, `Estimated for your height and ${bodyLabel}.`);
      }
    });
  });

  manualToggle.addEventListener('click', function () {
    manualSection.classList.toggle('hidden');
    this.textContent = manualSection.classList.contains('hidden')
      ? 'I know my exact inseam — enter it instead →'
      : 'Use body type selector instead ↑';
  });

  document.getElementById('manual-calc-btn')!.addEventListener('click', function () {
    const inseamEl = document.getElementById('inseam-input') as HTMLInputElement;
    const inseam = parseFloat(inseamEl.value);
    if (!inseam || inseam < 26 || inseam > 42) {
      inseamEl.style.borderColor = 'red';
      return;
    }
    inseamEl.style.borderColor = '';
    const thigh = inseam * 0.52;
    const minDepth = Math.round((thigh - 2.5) * 2) / 2;
    showResults(minDepth, `Based on your ${inseam}" inseam, leaving 2–3" of clearance at the knee (Cornell Ergonomics Lab guideline).`);
  });

  function showResults(minDepth: number, note: string) {
    resultsEl.classList.remove('hidden');
    document.getElementById('result-depth')!.textContent = minDepth.toFixed(1) + '"';
    document.getElementById('result-note')!.textContent = note;

    const chairsEl = document.getElementById('result-chairs')!;
    chairsEl.innerHTML = '';

    chairs.forEach((chair) => {
      const fits = chair.maxDepth >= minDepth;
      const div = document.createElement('div');
      div.className = `flex items-start gap-3 p-3 rounded-lg ${
        fits ? 'bg-green-50 border border-green-200' : 'bg-red-50 border border-red-200'
      }`;
      div.innerHTML = `
        <span class="text-base mt-0.5 shrink-0">${fits ? '✓' : '✗'}</span>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
            <a href="${chair.url}" class="text-sm font-semibold ${fits ? 'text-green-800' : 'text-red-800'} hover:underline">${chair.name}</a>
            <span class="text-xs text-muted-foreground">(${chair.note})</span>
          </div>
          <p class="text-xs mt-0.5 ${fits ? 'text-green-700' : 'text-red-700'}">
            ${fits ? 'Covers your ' + minDepth.toFixed(1) + '" minimum' : 'Max depth (' + chair.maxDepth + '") falls short of your ' + minDepth.toFixed(1) + '" minimum'}
          </p>
        </div>
        ${fits ? `<a href="${chair.amazon}" target="_blank" rel="noopener noreferrer sponsored" class="shrink-0 text-xs bg-primary text-primary-foreground px-3 py-1.5 rounded-md font-medium hover:bg-primary/90 transition-colors">View →</a>` : ''}
      `;
      chairsEl.appendChild(div);
    });

    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
})();
</script>
