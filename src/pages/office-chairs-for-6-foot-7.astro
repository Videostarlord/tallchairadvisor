                <th class="px-4 py-3 text-left font-semibold text-heading">Steelcase Gesture</th>
                <th class="px-4 py-3 text-left font-semibold text-heading">Leap Plus</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr class="bg-card">
                <td class="px-4 py-3 text-muted-foreground font-medium">Seat Height Max</td>
                <td class="px-4 py-3 text-muted-foreground font-medium">~22–24"</td>
                <td class="px-4 py-3 text-red-600 font-medium">20.5" — fails</td>
                <td class="px-4 py-3 text-red-600 font-medium">21" — fails</td>
                <td class="px-4 py-3 text-yellow-700 font-medium">22.5" &mdash; marginal <span class="text-xs font-normal">(w/ optional 5" cyl.; 19.5" std &mdash; fails)</span></td>
              </tr>
