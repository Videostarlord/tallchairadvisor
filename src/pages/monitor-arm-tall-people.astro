                <th class="text-center p-3 font-semibold text-heading">Monitor Top Required (28" desk)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr class="hover:bg-secondary/20">
                <td class="p-3 font-medium">6'0"</td>
                <td class="p-3 text-center">~50"</td>
                <td class="p-3 text-center">~20" above desk</td>
