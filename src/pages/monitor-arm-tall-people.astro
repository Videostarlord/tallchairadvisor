                <th class="text-center p-3 font-semibold text-heading">Estimated Seated Eye Level</th>
                <th class="text-center p-3 font-semibold text-heading">Monitor Top Required (30" desk)</th>
                <th class="text-center p-3 font-semibold text-heading">Monitor Top Required (28" desk)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
