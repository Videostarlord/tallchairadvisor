              <td class="px-4 py-3 font-medium text-heading">Steelcase Gesture</td>
              <td class="px-4 py-3 text-muted-foreground">16–21"</td>
              <td class="px-4 py-3 text-muted-foreground">15.75–18.75" (adj)</td>
              <td class="px-4 py-3 text-muted-foreground">24"</td>
              <td class="px-4 py-3 text-muted-foreground">400 lbs</td>
              <td class="px-4 py-3 font-medium text-red-700 dark:text-red-400">Not recommended — seat height and depth both fall short</td>
            </tr>
            <tr class="bg-card">
              <td class="px-4 py-3 font-medium text-heading">Aeron Size C</td>
