                <td class="px-4 py-3 text-amber-600 font-medium">24" — Marginal</td>
                <td class="px-4 py-3 text-green-700 font-medium">25.5" — Pass</td>
              </tr>
              <tr class="bg-secondary/20">
                <td class="px-4 py-3 font-medium text-muted-foreground">Adjustable Depth</td>
                <td class="px-4 py-3 text-muted-foreground">Required</td>
