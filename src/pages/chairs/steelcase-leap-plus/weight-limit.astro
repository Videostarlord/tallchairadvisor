                <td class="py-2 px-3">21"</td>
                <td class="py-2 px-3">20.5"</td>
              </tr>
              <tr>
                <td class="py-2 px-3 font-medium">Back height</td>
                <td class="py-2 px-3 font-semibold text-heading">25.5"</td>
