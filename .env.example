# Apify API token — get yours at https://console.apify.com/account/integrations
APIFY_TOKEN=

# Anthropic API key — used by reddit:summarize to generate structured insights
ANTHROPIC_API_KEY=

# Google Analytics 4 — set in Cloudflare Pages environment variables
PUBLIC_GA_MEASUREMENT_ID=
# GA4 numeric property ID for ga4-pull.ts (Admin → Property Settings → Property ID, NOT the G-XXXXXXXX tag)
# The service account in credentials/gsc-service-account.json must be added to the GA4 property
# with Viewer role (GA4 Admin → Property Access Management) and the
# "Google Analytics Data API" must be enabled in Google Cloud Console.
GA4_PROPERTY_ID=

# DataForSEO credentials — required for keyword-discovery.ts
# Sign up at https://dataforseo.com/ and find API credentials in your dashboard
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
# Set to 'false' to use production API (costs money). Default: sandbox (free).
DATAFORSEO_SANDBOX=true
